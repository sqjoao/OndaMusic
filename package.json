{
  "name": "onda-player",
  "productName": "Onda",
  "version": "1.1.1",
  "description": "Player pessoal de música para Windows",
  "author": "sqjoao",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.sqjoao.onda",
    "productName": "Onda",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "desktop/main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "onda-setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onda"
    },
    "extraResources": [
      {
        "from": "musicas",
        "to": "musicas",
        "filter": [
          "**/*.[mM][pP]3",
          "**/*.[wW][aA][vV]",
          "**/*.[oO][gG][gG]",
          "**/*.[oO][gG][aA]",
          "**/*.[mM]4[aA]",
          "**/*.[aA][aA][cC]",
          "**/*.[fF][lL][aA][cC]",
          "**/*.[oO][pP][uU][sS]",
          "**/*.[aA][iI][fF]",
          "**/*.[aA][iI][fF][fF]",
          "**/*.[wW][eE][bB][mM]"
        ]
      }
    ]
  }
}
