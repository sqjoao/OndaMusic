{
  "name": "onda-player",
  "productName": "Onda",
  "version": "1.1.4",
  "description": "Onda",
  "author": "sqjoao",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.sqjoao.onda",
    "productName": "Onda",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "desktop/main.cjs",
      "package.json",
      "desktop/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "onda-setup-${arch}.${ext}",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onda"
    }
  }
}
